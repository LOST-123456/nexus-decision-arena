NODE_ENV=development
PORT=4100
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus

# --- Trusted web origins (CORS + CSRF) -------------------------------------
# Every state-changing request that carries the session cookie, plus login and
# logout, is refused unless its `Origin` is exactly one of these. The list is
# the *only* source of truth: it is never derived from `Host`,
# `X-Forwarded-Host` or `Forwarded`, so a spoofed header cannot widen it.
#
# WEB_ORIGIN   single origin, the older setting; still works.
# WEB_ORIGINS  comma-separated, for a deployment that serves the UI from more
#              than one origin (e.g. app + admin). Both may be set; the lists
#              are merged.
#
# Each entry must be a bare origin: scheme://host[:port], with no path, query,
# fragment, credentials or wildcard. An unresolvable entry stops start-up with
# every problem listed at once.
#
# A PUBLIC deployment (see the authentication section below) with neither set
# refuses to start rather than falling back to "allow everything". A local run
# with neither set trusts http://localhost:3000 and http://127.0.0.1:3000 and
# says so on stderr.
WEB_ORIGIN=http://localhost:3000
# WEB_ORIGINS=https://app.example.com,https://admin.example.com

# --- Authentication -------------------------------------------------------
# Local development only. The values below are published in this repository and
# in the login page, so they are acceptable for a machine nobody else can reach
# and for nothing else.
#
# A deployment is treated as PUBLIC when any of these is true:
#   NODE_ENV=production, NEXUS_PUBLIC_DEPLOYMENT=true, NEXUS_DEMO_MODE=false
# A public deployment refuses to start unless AUTH_SECRET and
# AUTH_DEFAULT_OWNER_PASSWORD are both set to strong values.
#   AUTH_SECRET                 >= 32 characters, not a value in this file
#   AUTH_DEFAULT_OWNER_PASSWORD >= 12 characters
#   AUTH_DEFAULT_VIEWER_PASSWORD optional; unset means no viewer is created
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_DEFAULT_OWNER_PASSWORD=nexus-owner
AUTH_DEFAULT_VIEWER_PASSWORD=nexus-viewer
# Where the account file lives. Defaults to .data/users.json.
# AUTH_USERS_PATH=/var/lib/nexus/users.json
# Marks the session cookie Secure. Defaults to true on a public deployment
# whose WEB_ORIGIN is https, and to false on a local http run (a Secure cookie
# is silently dropped over plain http).
# AUTH_COOKIE_SECURE=true

LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1200
DEMO_FIXTURE=lab-safety-project.json

CROSS_EXAMINATION_MAX_CLAIMS=5
CROSS_EXAMINATION_MAX_CHALLENGERS=2
