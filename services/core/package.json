{
  "name": "@nexus/core",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus/db": "workspace:*",
    "@nexus/llm": "workspace:*",
    "@nexus/shared": "workspace:*",
    "drizzle-orm": "0.40.1",
    "fastify": "5.2.1",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "unpdf": "^1.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "jszip": "^3.10.2",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.8"
  }
}
