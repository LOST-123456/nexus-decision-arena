{
  "name": "nexus-decision-arena",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "demo:fixture": "tsx scripts/run-demo.ts",
    "dev": "corepack pnpm --parallel --filter @nexus/core --filter @nexus/web dev",
    "smoke:provider": "tsx scripts/provider-smoke.ts",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm --filter @nexus/web test:e2e",
    "test:stability": "tsx scripts/test-stability.ts",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@nexus/llm": "workspace:*",
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.8"
  }
}